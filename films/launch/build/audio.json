  {"beat":"b3","uri":"workspace://assets/e17aa16e98b0.mp3","dur":2.508,"text":"Now Quillon writes the document itself."},
  {"beat":"b4","uri":"workspace://assets/a8d9498e2495.mp3","dur":5.407,"text":"Ask for a two-page client alert on the Meridian facilities, in your firm's style."},
